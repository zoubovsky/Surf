# =============================================================================
# Surf daemon environment. Reference for /etc/surf/surf.env on the server.
#
# You normally do NOT write this file by hand: .github/workflows/deploy.yml renders
# it from GitHub Actions secrets (blank values below) and repository variables
# (Settings -> Secrets and variables -> Actions -> Variables) for everything else.
# A variable that is not set falls back to the default shown here.
#
# For local development copy it to .env (gitignored) and fill it in.
# Read by packages/core/src/config.ts (zod schema); unknown keys are ignored.
# =============================================================================

# ---- Mode & scheduling --------------------------------------------------------
# shadow = full loop, posts to Telegram, places NO orders. live = places orders.
TRADING_MODE=shadow
# IANA zone used for the daily brief and log timestamps.
TZ=Europe/London
# HH:MM in TZ.
DAILY_BRIEF_TIME=07:00
# Where the SQLite database, backups and raw API bodies live. In Docker this is
# the /data volume (host: /var/lib/surf/data). Locally ./data.
DATA_DIR=/data
# trace | debug | info | warn | error
LOG_LEVEL=info
# Strike market symbol.
SYMBOL=BTC-USD

# ---- Strike Finance -----------------------------------------------------------
STRIKE_API_BASE=https://api.strikefinance.org
STRIKE_WS_BASE=wss://api.strikefinance.org
# API wallet keys, 64 hex chars each (the API wallet cannot withdraw). SECRET.
STRIKE_API_PUBLIC_KEY=
STRIKE_API_PRIVATE_KEY=

# ---- Anthropic ----------------------------------------------------------------
# SECRET. Set a monthly spend limit in console.anthropic.com as well.
ANTHROPIC_API_KEY=
MODEL_TRIAGE=claude-haiku-4-5
MODEL_RESEARCHER=claude-sonnet-5
MODEL_ANALYST=claude-opus-5
MODEL_REVIEWER=claude-opus-5

# ---- Telegram -----------------------------------------------------------------
# SECRET (bot token from @BotFather). The chat id is a number; only this chat is served.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Transcripts / ingestion --------------------------------------------------
# SECRET. supadata.ai key; without it transcript retrieval uses slower fallbacks
# (yt-dlp + ffmpeg are in the image; DEEPGRAM_API_KEY enables audio transcription).
SUPADATA_API_KEY=
DEEPGRAM_API_KEY=
# Optional aggregate open interest.
COINALYZE_API_KEY=
# Optional news (not read by config.ts yet; reserved).
FINNHUB_API_KEY=
YOUTUBE_CHANNEL_ID=UCngIhBkikUe6e7tZTjpKK7Q
YOUTUBE_LONGFORM_PLAYLIST=UULFngIhBkikUe6e7tZTjpKK7Q
# Videos older than this many hours are not used as a prior.
PRIOR_MAX_AGE_HOURS=48
# Resting entry orders are cancelled if still unfilled after this many hourly bars.
RESTING_TTL_BARS=12

# ---- Risk limits (see docs/decisions/0004-autonomy-and-risk-defaults.md) -----
# Leave blank to use the defaults compiled into packages/core RiskLimits.
RISK_PER_TRADE_PCT=
MAX_LEVERAGE=
MAX_DAILY_LOSS_PCT=
MAX_DRAWDOWN_PCT=
DAILY_LLM_BUDGET_USD=
